# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL used to build auth redirect/callback links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — used by the contact form. Without this set, the form still
# renders but returns a "not configured yet" message instead of sending.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@waework.co

# Cloudflare Turnstile — used by the contact form. Without a site key,
# the widget is skipped and the server just accepts submissions unverified.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Phase 2+ (not yet used) ---
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
