# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL used to build auth redirect/callback links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — used by the contact form. Without this set, the form still
# renders but returns a "not configured yet" message instead of sending.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@waework.co

# Cloudflare Turnstile — used by the contact form. Without a site key,
# the widget is skipped and the server just accepts submissions unverified.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe — payments (escrow hold/release/refund), Connect payouts, and
# Identity verification. Without STRIPE_SECRET_KEY, escrow/release/refund
# functions still run but log a simulated payment_events row instead of
# moving real money, and the verification step shows an honest "not
# configured yet" state instead of redirecting to a broken checkout.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_IDENTITY_WEBHOOK_SECRET=

# Daily.co — embedded interview video calls. Without DAILY_API_KEY, the
# interview call screen shows a manual "coordinate the call yourselves and
# mark it complete" fallback instead of a live room.
DAILY_API_KEY=

# Singpass/MyInfo — scaffolded but not switched on (see the plan's
# reconciliation notes: real integration needs a relying-party
# registration with the SG government). Stripe Identity is the universal
# verification path until these are set.
MYINFO_CLIENT_ID=
MYINFO_CLIENT_SECRET=
MYINFO_AUTHORIZE_URL=

# Authorizes calls to /api/cron/auto-approve-milestones — set this to a
# random secret and configure the same value as the Vercel Cron job's
# Authorization header.
CRON_SECRET=

# PostHog — product analytics (signup started/completed, job posted,
# application submitted, payment completed). Server-side only (posthog-
# node), no client bundle. Without POSTHOG_API_KEY, every trackEvent()
# call just no-ops.
POSTHOG_API_KEY=
POSTHOG_HOST=
